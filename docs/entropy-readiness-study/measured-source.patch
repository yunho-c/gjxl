+// Local measurement instrumentation. Not a production API.
+#pragma once
+#include <algorithm>
+#include <atomic>
+#include <cstdint>
+#include <cstring>
+#include <memory>
+#include <ostream>
+#include <mach/mach_time.h>
+#include <pthread.h>
+
+namespace gjxl::boundary_trace_internal {
+inline uint64_t Now() noexcept {
+  static const auto timebase = [] { mach_timebase_info_data_t t; mach_timebase_info(&t); return t; }();
+  const uint64_t ticks = mach_absolute_time();
+  return static_cast<uint64_t>((static_cast<__uint128_t>(ticks) * timebase.numer) / timebase.denom);
+}
+inline uint64_t Thread() noexcept {
+  thread_local const uint64_t id = [] { uint64_t n = 0; pthread_threadid_np(nullptr, &n); return n; }();
+  return id;
+}
+struct Event {
+  char name[96]{};
+  const char* kind = "cpu";
+  uint64_t begin = 0, end = 0, tid = 0, value = 0;
+  uint32_t job = 0;
+};
+struct Sink {
+  static constexpr size_t capacity = 65536;
+  std::unique_ptr<Event[]> events = std::make_unique<Event[]>(capacity);
+  std::atomic<size_t> count{0};
+  std::atomic<uint32_t> jobs{0};
+  void Reset() { count.store(0); jobs.store(0); }
+  void Add(const char* name, const char* kind, uint64_t begin, uint64_t end,
+           uint32_t job, uint64_t value = 0) noexcept {
+    const auto i = count.fetch_add(1, std::memory_order_relaxed);
+    if (i >= capacity) return;
+    auto& e = events[i];
+    const auto n = std::min(std::strlen(name), sizeof(e.name) - 1);
+    std::memcpy(e.name, name, n); e.name[n] = 0;
+    e.kind = kind; e.begin = begin; e.end = end; e.job = job; e.tid = Thread(); e.value = value;
+  }
+  void Write(std::ostream& out) const {
+    out << '[';
+    for (size_t i = 0; i < std::min(count.load(), capacity); ++i) {
+      const auto& e = events[i];
+      if (i) out << ',';
+      out << "{\"name\":\"" << e.name << "\",\"kind\":\"" << e.kind
+          << "\",\"begin_ns\":" << e.begin << ",\"end_ns\":" << e.end
+          << ",\"job\":" << e.job << ",\"tid\":" << e.tid << ",\"value\":" << e.value << '}';
+    }
+    out << ']';
+  }
+};
+struct Context { Sink* sink = nullptr; uint32_t job = 0; };
+inline std::atomic<Sink*> active_sink{nullptr};
+inline thread_local Context current;
+struct ContextScope {
+  Context previous;
+  explicit ContextScope(Context value) : previous(current) { current = value; }
+  ~ContextScope() { current = previous; }
+};
+struct RootScope {
+  Context previous;
+  RootScope() : previous(current) {
+    if (auto* sink = active_sink.load(std::memory_order_relaxed))
+      current = {sink, sink->jobs.fetch_add(1, std::memory_order_relaxed) + 1};
+  }
+  ~RootScope() { current = previous; }
+};
+struct Span {
+  Context context;
+  const char* name;
+  const char* kind;
+  uint64_t begin = 0, value;
+  Span(const char* name, uint64_t value = 0) : Span(current, name, "cpu", value) {}
+  Span(Context context, const char* name, const char* kind = "cpu", uint64_t value = 0)
+      : context(context), name(name), kind(kind), value(value) { if (context.sink) begin = Now(); }
+  void End() noexcept {
+    if (context.sink) { context.sink->Add(name, kind, begin, Now(), context.job, value); context.sink = nullptr; }
+  }
+  ~Span() { End(); }
+};
+inline void Point(const char* name, uint64_t value = 0) {
+  if (current.sink) { const auto now = Now(); current.sink->Add(name, "point", now, now, current.job, value); }
+}
