@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(@GJXL_ENABLE_CUDA@)
  find_dependency(CUDAToolkit)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/gjxlTargets.cmake")

foreach(component IN ITEMS core codec codestream c cuda)
  if(TARGET "gjxl::${component}")
    set("gjxl_${component}_FOUND" TRUE)
  endif()
endforeach()

check_required_components(gjxl)
